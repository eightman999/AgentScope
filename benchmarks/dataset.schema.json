{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentScope benchmark JSONL row",
  "description": "Each non-empty line in a benchmark dataset is one object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "url",
    "commit_sha",
    "category",
    "annotation_status",
    "human_labels",
    "human_scores",
    "annotation"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,99}$"},
    "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "category": {
      "enum": [
        "clearly_agentic",
        "llm_non_agent",
        "mcp_tooling_only",
        "ai_assisted_only",
        "hard_case"
      ]
    },
    "annotation_status": {"enum": ["pending", "draft", "adjudicated"]},
    "human_labels": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "ai_assisted_development",
          "agentic_runtime",
          "mcp_tooling",
          "formal_github_fork",
          "derived_concept"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/label"}
    },
    "human_scores": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "originality",
          "agenticity",
          "dynamic_tool_selection",
          "feedback_adaptation",
          "goal_directed_loop",
          "verification",
          "agent_tooling"
        ]
      },
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 10}
    },
    "annotation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "score_evidence": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "originality",
              "agenticity",
              "dynamic_tool_selection",
              "feedback_adaptation",
              "goal_directed_loop",
              "verification",
              "agent_tooling"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "rationale", "evidence"],
      "properties": {
        "value": {"enum": ["yes", "no", "unknown", "ambiguous"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "file",
        "start_line",
        "end_line",
        "excerpt",
        "reason",
        "commit_sha"
      ],
      "properties": {
        "source_kind": {"enum": ["repository", "git", "github_api", "derived_manifest"]},
        "file": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    }
  }
}
