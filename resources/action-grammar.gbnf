root ::= toolcall | finish
toolcall ::= "{" ws "\"kind\"" ws ":" ws "\"tool_call\"" ws "," ws "\"tool\"" ws ":" ws toolname ws "," ws "\"arguments\"" ws ":" ws object ws "," ws "\"hypothesis\"" ws ":" ws string ws "," ws "\"focus\"" ws ":" ws stringarray ws "}"
finish ::= "{" ws "\"kind\"" ws ":" ws "\"finish\"" ws "," ws "\"decision\"" ws ":" ws decision ws "," ws "\"reason\"" ws ":" ws string ws "," ws "\"missing_unknowns\"" ws ":" ws stringarray ws "}"
toolname ::= "\"list_repo_tree\"" | "\"read_file\"" | "\"search_code\"" | "\"inspect_llm_calls\"" | "\"inspect_tooling\"" | "\"trace_call_graph\"" | "\"inspect_git_provenance\"" | "\"inspect_github_metadata\"" | "\"inspect_tests\"" | "\"inspect_concept_lineage\"" | "\"finish_audit\""
decision ::= "\"ENOUGH_EVIDENCE\"" | "\"INSUFFICIENT_EVIDENCE\""
object ::= "{" ws members? ws "}"
members ::= member (ws "," ws member)*
member ::= string ws ":" ws value
value ::= object | array | string | number | boolean | null
array ::= "[" ws elements? ws "]"
elements ::= value (ws "," ws value)*
stringarray ::= "[" ws stringelements? ws "]"
stringelements ::= string (ws "," ws string)*
string ::= "\"" ( [^\"\\] | "\\" ( [\"\\/bfnrt] | "u" [0-9a-fA-F]{4} ) )* "\""
number ::= "-"? ( "0" | [1-9] [0-9]* ) ( "." [0-9]+ )? ( [eE] [+-]? [0-9]+ )?
boolean ::= "true" | "false"
null ::= "null"
ws ::= [ \t\n\r]*
